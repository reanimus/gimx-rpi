#!/usr/bin/env python3
"""Pi UART Bluetooth diagnostics. Never treats tool exit status as HCI success."""
import argparse
import datetime
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time


def address(value):
    if not re.fullmatch(r'(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}', value):
        raise ValueError('Expected six colon-separated hexadecimal octets')
    value = value.upper()
    if value in ('00:00:00:00:00:00', 'FF:FF:FF:FF:FF:FF'):
        raise ValueError('Zero and all-ones addresses are not valid test targets')
    return value


def vendor_bytes(value):
    return address(value).split(':')[::-1]


def completion(output, opcode):
    # hcitool prints Command Complete parameters after the event header.
    for block in re.split(r'(?m)^\s*[<>] HCI Event:', output)[1:]:
        header, _, body = block.partition('\n')
        event = re.fullmatch(r'\s*0x([0-9a-fA-F]+)\s+plen\s+(\d+)\s*', header)
        if not event or int(event[1], 16) != 0x0e:
            continue
        octets = []
        for line in body.splitlines():
            if not re.fullmatch(r'\s*(?:[0-9a-fA-F]{2}\s+)*[0-9a-fA-F]{2}\s*', line):
                break
            octets.extend(line.split())
        data = bytes(int(v, 16) for v in octets)
        if len(data) != int(event[2]):
            continue
        if len(data) >= 4 and int.from_bytes(data[1:3], 'little') == opcode:
            if data[3]:
                raise RuntimeError(f'HCI opcode 0x{opcode:04x} status 0x{data[3]:02x}')
            return data[4:]
    raise RuntimeError(f'No matching successful Command Complete for 0x{opcode:04x}')


def supports_broadcom_address_write(version):
    # BlueZ company IDs: Broadcom 15; Cypress Semiconductor 305.
    return len(version) == 8 and int.from_bytes(version[4:6], 'little') in (15, 305)


def run(*args, required=True):
    p = subprocess.run(args, text=True, stdout=subprocess.PIPE,
                       stderr=subprocess.STDOUT, timeout=25)
    print('+', ' '.join(args), flush=True)
    print(p.stdout, end='', flush=True)
    if required and p.returncode:
        raise RuntimeError(f'{args[0]} exited {p.returncode}')
    return p.stdout


def find_device(device_path):
    for p in Path('/sys/class/bluetooth').glob('hci*'):
        if (p / 'device').resolve() == device_path:
            return p.name
    raise RuntimeError('Controller disappeared; inspect UART/firmware logs')


def hci(dev, ogf, ocf, *params):
    output = run('hcitool', '-i', dev, 'cmd', hex(ogf), hex(ocf), *params)
    return completion(output, (ogf << 10) | ocf)


def read_address(dev):
    data = hci(dev, 4, 9)
    if len(data) != 6:
        raise RuntimeError('Malformed Read BD_ADDR response')
    return ':'.join(f'{b:02X}' for b in data[::-1])


def cached(dev):
    # Bluetooth sysfs does not reliably expose an address attribute.
    output = run('hciconfig', dev)
    match = re.search(r'BD Address:\s*((?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2})\b', output)
    if not match:
        raise RuntimeError('Cannot read kernel Bluetooth address from hciconfig')
    return address(match[1])


def snapshot(dev):
    run('uname', '-a', required=False)
    run('rfkill', 'list', required=False)
    run('btmgmt', '-i', dev, 'info', required=False)
    run('btmgmt', '-i', dev, 'config', required=False)
    run('hciconfig', dev, '-a', required=False)
    run('journalctl', '-k', '-b', '--no-pager', '-n', '150', required=False)


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument('action', choices=['inspect', 'set', 'restore'])
    p.add_argument('target', nargs='?')
    p.add_argument('--hci', default='hci0')
    p.add_argument('--method', choices=['auto', 'mgmt', 'vendor'], default='auto')
    a = p.parse_args()
    if os.geteuid():
        p.error('Run with sudo')
    if not re.fullmatch(r'hci[0-9]+', a.hci):
        p.error('Invalid HCI device name')
    if a.action == 'set':
        a.target = address(a.target or '')
    elif a.target:
        p.error('A target address is only valid with set')
    logdir = Path('/var/log/gimx')
    logdir.mkdir(parents=True, exist_ok=True)
    # tee both streams while preserving a useful terminal transcript.
    logfile = logdir / ('bt-' + datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f') + '.log')
    with logfile.open('w') as log:
        class Tee:
            def write(self, s):
                sys.__stdout__.write(s); log.write(s); log.flush()
            def flush(self):
                sys.__stdout__.flush(); log.flush()
        sys.stdout = Tee()
        try:
            dev = a.hci
            if not (Path('/sys/class/bluetooth') / dev).exists():
                raise RuntimeError(f'{dev} absent: inspect journalctl -k and rfkill; no USB fallback is selected')
            device = (Path('/sys/class/bluetooth') / dev / 'device').resolve()
            print('Controller path:', device)
            snapshot(dev)
            if a.action == 'inspect':
                return 0
            info = run('hciconfig', dev, '-a')
            if not re.search(r'Bus:\s*UART', info):
                raise RuntimeError('Refusing address write: selected controller is not UART')
            run('systemctl', 'mask', '--runtime', '--now', 'bluetooth.service')
            run('rfkill', 'unblock', 'bluetooth')
            run('hciconfig', dev, 'up')
            original = read_address(dev)
            state = Path('/var/lib/gimx')
            state.mkdir(parents=True, exist_ok=True)
            saved = state / 'original-bdaddr.json'
            if not saved.exists():
                saved.write_text(json.dumps({'device': str(device), 'address': original}) + '\n')
                saved.chmod(0o600)
            record = json.loads(saved.read_text())
            if record['device'] != str(device):
                raise RuntimeError('Saved original address belongs to another controller')
            target = address(record['address']) if a.action == 'restore' else a.target
            print('Original saved:', record['address'], 'Current:', original, 'Target:', target)
            success = False
            if a.method in ('auto', 'mgmt'):
                run('btmgmt', '-i', dev, 'power', 'off')
                run('btmgmt', '-i', dev, 'public-addr', target, required=False)
                time.sleep(1)
                dev = find_device(device)  # mgmt is allowed to change the index.
                run('hciconfig', dev, 'up')
                success = read_address(dev) == target and cached(dev) == target
            if not success and a.method in ('auto', 'vendor'):
                version = hci(dev, 4, 1)
                if not supports_broadcom_address_write(version):
                    raise RuntimeError('Refusing Broadcom command: manufacturer is not Broadcom/Cypress')
                hci(dev, 0x3f, 1, *vendor_bytes(target))
                immediate = read_address(dev)
                print('Immediate controller address:', immediate, 'Kernel cache:', cached(dev))
                if immediate != target:
                    raise RuntimeError('Vendor write acknowledged, but immediate readback differs')
                # Reopening refreshes the host view; firmware may overwrite the address.
                run('hciconfig', dev, 'down')
                run('hciconfig', dev, 'up')
                success = read_address(dev) == target and cached(dev) == target
            snapshot(dev)
            if not success:
                raise RuntimeError('Address did not survive reopen in BOTH controller and kernel. Not GIMX-ready; use restore or cold reboot and inspect again.')
            print('PASS: controller and kernel agree after reopen. This does NOT prove PS4 compatibility.')
            print('Restore: sudo gimx-bt restore --hci', dev)
            return 0
        except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired) as e:
            print('FAIL:', e)
            return 1
        finally:
            print('Log:', logfile)
            sys.stdout = sys.__stdout__


if __name__ == '__main__':
    sys.exit(main())
