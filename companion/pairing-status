#!/usr/bin/env python3
"""Show saved pairing status without printing the link key."""
from pathlib import Path
p=Path('/var/lib/gimx-pairing/state.bin')
try:
    data=p.read_bytes()
except FileNotFoundError:
    raise SystemExit('No state saved yet; check sudo journalctl -u gimx-pairing')
if len(data)!=36 or data[:8]!=b'GIMXPAIR':
    raise SystemExit('Invalid pairing state; preserve the file for diagnosis')
def addr(data):return ':'.join(f'{x:02X}' for x in data[::-1])
print('Emulated Bluetooth address:',addr(data[8:14]))
print('PS4 Bluetooth address:',addr(data[14:20]))
print('Link key:', 'present' if any(data[20:36]) else 'not paired')
print('State file is written atomically and fsynced after each change.')
