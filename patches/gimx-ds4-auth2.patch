+/* Bluetooth-only 03/04 is answered locally, never forwarded to USB. */
+static void auth_exchange(struct ds4_usb_auth *auth, const uint8_t *packet,
+                          size_t length, struct ds4_usb_reply *reply)
+{
+  if (!auth->auth2_enabled || length < 2 ||
+      !((packet[0] == 0x53 && packet[1] == 0x03) ||
+        ((packet[0] == 0x43 || packet[0] == 0x4b) && packet[1] == 0x04))) {
+    exchange(auth->hid, packet, length, reply);
+    return;
+  }
+  memset(reply, 0, sizeof(*reply));
+  reply->header = packet[0];
+  reply->report = packet[1];
+  handshake(reply, 0x04);
+  if (packet[0] == 0x53) {
+    auth->auth2_ready = 0; /* Never return a prior response after a rejected SET. */
+    if (length != 40 || !valid_crc(packet, length) || packet[3] >= 16) return;
+    uint8_t *out = auth->auth2_response;
+    MHASH hash = mhash_init(MHASH_SHA1);
+    if (hash == MHASH_FAILED) {
+      reply->error = ENOMEM;
+      handshake(reply, 0x0e);
+      return;
+    }
+    mhash(hash, auth->table[packet[3]], 32);
+    mhash(hash, packet + 4, 32);
+    mhash(hash, auth->salt, sizeof(auth->salt));
+    out[0] = 0xa3;
+    out[1] = 0x04;
+    out[2] = packet[2]; /* Echo the sequence and table slot. */
+    out[3] = packet[3];
+    mhash_deinit(hash, out + 4);
+    memcpy(out + 24, auth->salt, sizeof(auth->salt));
+    put_crc(out, sizeof(auth->auth2_response));
+    auth->auth2_ready = 1;
+    handshake(reply, 0x00);
+  } else {
+    if (length != (packet[0] == 0x4b ? 4U : 2U)) return;
+    if (packet[0] == 0x4b && ((unsigned)packet[2] | (unsigned)packet[3] << 8) < 47)
+      return;
+    if (!auth->auth2_ready) { handshake(reply, 0x01); return; } /* Not ready. */
+    reply->length = sizeof(auth->auth2_response);
+    memcpy(reply->data, auth->auth2_response, reply->length);
+  }
+}
