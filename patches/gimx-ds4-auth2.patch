+/* User-supplied controller data, not part of this source or its license.
+ * Format/hash reference: dogtopus ds40304poke.py, gist
+ * 931ba2cc911a1c13b21d1b3fd34de493 revision fe1639180f9af329db5fdbe6a695b38a27ff8607.
+ */
+static int auth2_load(struct ds4_usb_auth *auth, const char *path)
+{
+  static const uint8_t expected[32] = {
+    0x98,0xb7,0x00,0xc5,0x68,0xbd,0x40,0xd1,0xa3,0xa2,0x80,0xa6,0x39,0x18,0xc3,0x57,
+    0xb1,0x71,0x36,0x66,0xd7,0xfb,0x99,0x2a,0xb0,0x8e,0x19,0xf9,0x6b,0xa3,0x1b,0x7d
+  };
+  auth->auth2_enabled = auth->auth2_ready = 0;
+  int fd = open(path, O_RDONLY | O_CLOEXEC | O_NONBLOCK);
+  if (fd < 0) return -1;
+  struct stat st;
+  if (fstat(fd, &st) < 0) goto fail;
+  if (!S_ISREG(st.st_mode) || st.st_size != sizeof(auth->table)) {
+    errno = EINVAL;
+    goto fail;
+  }
+  size_t offset = 0;
+  while (offset < sizeof(auth->table)) {
+    ssize_t n = read(fd, (uint8_t *)auth->table + offset, sizeof(auth->table) - offset);
+    if (n < 0 && errno == EINTR) continue;
+    if (n <= 0) { if (n == 0) errno = EINVAL; goto fail; }
+    offset += n;
+  }
+  uint8_t extra;
+  ssize_t n;
+  do { n = read(fd, &extra, 1); } while (n < 0 && errno == EINTR);
+  if (n != 0) { if (n > 0) errno = EINVAL; goto fail; }
+  uint8_t digest[32];
+  MHASH hash = mhash_init(MHASH_SHA256);
+  if (hash == MHASH_FAILED) { errno = ENOMEM; goto fail; }
+  mhash(hash, auth->table, sizeof(auth->table));
+  mhash_deinit(hash, digest);
+  if (memcmp(digest, expected, sizeof(digest))) { errno = EBADMSG; goto fail; }
+  /* The public verifier hashes the returned 20-byte salt. We generate one per
+   * session, stable across challenges; this is not a reconstructed device-data
+   * digest. Whether the PS4 imposes further salt constraints needs hardware testing.
+   */
+  offset = 0;
+  while (offset < sizeof(auth->salt)) {
+    n = getrandom(auth->salt + offset, sizeof(auth->salt) - offset, 0);
+    if (n < 0 && errno == EINTR) continue;
+    if (n <= 0) { if (n == 0) errno = EIO; goto fail; }
+    offset += n;
+  }
+  close(fd);
+  auth->auth2_enabled = 1;
+  return 0;
+fail:;
+  int saved = errno;
+  close(fd);
+  explicit_bzero(auth->table, sizeof(auth->table));
+  errno = saved;
+  return -1;
+}
