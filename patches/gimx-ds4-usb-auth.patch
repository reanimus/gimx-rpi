diff --git a/core/connectors/linux/usb_auth/ds4_usb_auth.c b/core/connectors/linux/usb_auth/ds4_usb_auth.c
new file mode 100644
index 0000000..b2bf2c0
--- /dev/null
+++ b/core/connectors/linux/usb_auth/ds4_usb_auth.c
@@ -0,0 +1,224 @@
+/* Experimental DS4 USB donor for the Bluetooth connector. GPL-3.0-or-later.
+ * Only reports with known USB equivalents are translated. In particular,
+ * Bluetooth 03/04 MUST NOT be passed to the unrelated USB report 04.
+ */
+#include "ds4_usb_auth.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/hidraw.h>
+#include <linux/input.h>
+#include <poll.h>
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/file.h>
+#include <sys/ioctl.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+struct ds4_usb_auth {
+  int hid, channel[2], busy;
+  pthread_t worker;
+};
+
+static uint32_t crc32(const uint8_t *data, size_t length)
+{
+  uint32_t crc = UINT32_MAX;
+  for (size_t i = 0; i < length; ++i) {
+    crc ^= data[i];
+    for (int b = 0; b < 8; ++b)
+      crc = (crc >> 1) ^ (0xedb88320U & (0U - (crc & 1U)));
+  }
+  return ~crc;
+}
+
+static void put_crc(uint8_t *data, size_t length)
+{
+  uint32_t crc = crc32(data, length - 4);
+  for (int i = 0; i < 4; ++i) data[length - 4 + i] = crc >> (8 * i);
+}
+
+static int valid_crc(const uint8_t *data, size_t length)
+{
+  uint32_t crc = crc32(data, length - 4);
+  for (int i = 0; i < 4; ++i)
+    if (data[length - 4 + i] != (uint8_t)(crc >> (8 * i))) return 0;
+  return 1;
+}
+
+static void handshake(struct ds4_usb_reply *reply, uint8_t status)
+{
+  reply->length = 1;
+  reply->data[0] = status;
+}
+
+/* USB calibration interleaves gyro +/- pairs; Bluetooth groups all +/- values. */
+static void calibration_to_bt(uint8_t *data)
+{
+  uint8_t gyro[12];
+  memcpy(gyro, data + 7, sizeof(gyro));
+  for (int axis = 0; axis < 3; ++axis) {
+    memcpy(data + 7 + axis * 2, gyro + axis * 4, 2);
+    memcpy(data + 13 + axis * 2, gyro + axis * 4 + 2, 2);
+  }
+}
+
+static void exchange(int hid, const uint8_t *packet, size_t length,
+                     struct ds4_usb_reply *reply)
+{
+  uint8_t usb[64] = {0};
+  size_t usb_length = 0, bt_length = 0;
+  int crc = 0;
+  memset(reply, 0, sizeof(*reply));
+  reply->header = length ? packet[0] : 0;
+  reply->report = length > 1 ? packet[1] : 0;
+  handshake(reply, 0x04); /* Invalid parameter unless a complete request matches. */
+  if (length < 2) return;
+  if (packet[0] == 0x53) {
+    if (packet[1] != 0xf0) goto unsupported;
+    if (length != 65 || !valid_crc(packet, length)) return;
+    memcpy(usb, packet + 1, sizeof(usb));
+    put_crc(usb, sizeof(usb)); /* USB excludes the HID transaction header. */
+    int ret = ioctl(hid, HIDIOCSFEATURE(sizeof(usb)), usb);
+    if (ret != (int)sizeof(usb)) {
+      reply->error = ret < 0 ? errno : EPROTO;
+      handshake(reply, 0x0e);
+    } else handshake(reply, 0x00);
+    return;
+  }
+  if (packet[0] != 0x43 && packet[0] != 0x4b) goto unsupported;
+  if (length != (packet[0] == 0x4b ? 4U : 2U)) return;
+  switch (packet[1]) {
+    case 0x02: usb[0] = 0x02; usb_length = bt_length = 37; break;
+    case 0x05: usb[0] = 0x02; usb_length = 37; bt_length = 41; crc = 1; break;
+    case 0x06: usb[0] = 0xa3; usb_length = 49; bt_length = 53; crc = 1; break;
+    case 0xa3: usb[0] = 0xa3; usb_length = bt_length = 49; break;
+    case 0xf1: usb[0] = 0xf1; usb_length = bt_length = 64; crc = 1; break;
+    case 0xf2: usb[0] = 0xf2; usb_length = bt_length = 16; crc = 1; break;
+    default: goto unsupported;
+  }
+  /* Do not advance the donor's F1 page cursor for an undersized request. */
+  if (packet[0] == 0x4b && ((unsigned)packet[2] | (unsigned)packet[3] << 8) < bt_length)
+    return;
+  uint8_t id = usb[0];
+  int ret = ioctl(hid, HIDIOCGFEATURE(usb_length), usb);
+  if (ret != (int)usb_length || usb[0] != id) {
+    reply->error = ret < 0 ? errno : EPROTO;
+    handshake(reply, 0x0e);
+    return;
+  }
+  if ((id == 0xf1 || id == 0xf2) && !valid_crc(usb, usb_length)) {
+    reply->error = EBADMSG;
+    handshake(reply, 0x0e);
+    return;
+  }
+  if (id == 0x02) calibration_to_bt(usb);
+  reply->data[0] = 0xa3;
+  memcpy(reply->data + 1, usb, usb_length);
+  reply->data[1] = packet[1];
+  reply->length = bt_length + 1;
+  if (crc) put_crc(reply->data, reply->length);
+  return;
+unsupported:
+  reply->unsupported = 1;
+  handshake(reply, 0x03);
+}
+
+static void *worker(void *arg)
+{
+  struct ds4_usb_auth *auth = arg;
+  uint8_t packet[65];
+  for (;;) {
+    ssize_t length = recv(auth->channel[1], packet, sizeof(packet), 0);
+    if (length < 0 && errno == EINTR) continue;
+    if (length <= 0) break;
+    struct ds4_usb_reply reply;
+    exchange(auth->hid, packet, length, &reply);
+    ssize_t sent;
+    do {
+      sent = send(auth->channel[1], &reply, sizeof(reply), MSG_NOSIGNAL);
+    } while (sent < 0 && errno == EINTR);
+    if (sent != (ssize_t)sizeof(reply)) break;
+  }
+  shutdown(auth->channel[1], SHUT_RDWR);
+  return NULL;
+}
+
+struct ds4_usb_auth *ds4_usb_open(const char *path)
+{
+  struct ds4_usb_auth *auth = calloc(1, sizeof(*auth));
+  if (!auth) return NULL;
+  auth->hid = open(path, O_RDWR | O_CLOEXEC | O_NONBLOCK);
+  auth->channel[0] = auth->channel[1] = -1;
+  if (auth->hid < 0) goto fail;
+  struct hidraw_devinfo info;
+  if (ioctl(auth->hid, HIDIOCGRAWINFO, &info) < 0) goto fail;
+  if (info.bustype != BUS_USB || (uint16_t)info.vendor != 0x054c ||
+      ((uint16_t)info.product != 0x09cc && (uint16_t)info.product != 0x05c4)) {
+    errno = ENODEV;
+    goto fail;
+  }
+  if (flock(auth->hid, LOCK_EX | LOCK_NB) < 0) goto fail;
+  if (socketpair(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0, auth->channel) < 0) goto fail;
+  int error = pthread_create(&auth->worker, NULL, worker, auth);
+  if (error) { errno = error; goto fail; }
+  return auth;
+fail:;
+  int saved = errno;
+  if (auth->channel[0] >= 0) close(auth->channel[0]);
+  if (auth->channel[1] >= 0) close(auth->channel[1]);
+  if (auth->hid >= 0) close(auth->hid);
+  free(auth);
+  errno = saved;
+  return NULL;
+}
+
+int ds4_usb_fd(const struct ds4_usb_auth *auth) { return auth->channel[0]; }
+
+int ds4_usb_alive(const struct ds4_usb_auth *auth)
+{
+  /* Check disconnection without consuming controller input reports. */
+  struct pollfd fds[2] = {{.fd = auth->hid}, {.fd = auth->channel[0]}};
+  int ret;
+  do { ret = poll(fds, 2, 0); } while (ret < 0 && errno == EINTR);
+  return ret >= 0 && !(fds[0].revents & (POLLERR | POLLHUP | POLLNVAL)) &&
+                     !(fds[1].revents & (POLLERR | POLLHUP | POLLNVAL));
+}
+
+int ds4_usb_submit(struct ds4_usb_auth *auth, const uint8_t *data, size_t length)
+{
+  if (auth->busy) { errno = EBUSY; return -1; }
+  if (!length || length > 65) { errno = EMSGSIZE; return -1; }
+  ssize_t sent;
+  do { sent = send(auth->channel[0], data, length, MSG_NOSIGNAL | MSG_DONTWAIT); }
+  while (sent < 0 && errno == EINTR);
+  if (sent != (ssize_t)length) return -1;
+  auth->busy = 1;
+  return 0;
+}
+
+int ds4_usb_receive(struct ds4_usb_auth *auth, struct ds4_usb_reply *reply)
+{
+  ssize_t length;
+  do { length = recv(auth->channel[0], reply, sizeof(*reply), MSG_DONTWAIT); }
+  while (length < 0 && errno == EINTR);
+  if (length < 0) return -1;
+  if (!auth->busy || length != (ssize_t)sizeof(*reply) ||
+      !reply->length || reply->length > sizeof(reply->data)) {
+    errno = EPROTO;
+    return -1;
+  }
+  auth->busy = 0;
+  return 0;
+}
+
+void ds4_usb_close(struct ds4_usb_auth *auth)
+{
+  if (!auth) return;
+  shutdown(auth->channel[0], SHUT_RDWR);
+  pthread_join(auth->worker, NULL);
+  close(auth->channel[0]);
+  close(auth->channel[1]);
+  close(auth->hid);
+  free(auth);
+}
