+  if (state->sys.shutdown || state->ps4_channels.control.id < 0) return 1;
+  if (l2cap_abs_get()->send(state->ps4_channels.control.id, reply.data, reply.length, 0) != (int)reply.length)
+    return usb_auth_failed(user);
+  /* USB/CRC failures end the attempt; unsupported reports remain observable. */
+  return reply.error ? usb_auth_failed(user) : 0;
+}
