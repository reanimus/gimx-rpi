+  if (reply.unsupported) {
+    state->usb_unsupported = 1;
+    fprintf(stderr, "USB auth: unsupported Bluetooth request header=0x%02x report=0x%02x; no USB equivalent implemented\n",
+            reply.header, reply.report);
