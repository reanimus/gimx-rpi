+static int read_usb_auth(void *user)
+{
+  struct btds4_state *state = states + (intptr_t)user;
+  struct ds4_usb_reply reply;
+  if (ds4_usb_receive(state->usb_auth, &reply) < 0) {
+    if (errno == EAGAIN || errno == EWOULDBLOCK) return 0;
+    return usb_auth_failed(user);
