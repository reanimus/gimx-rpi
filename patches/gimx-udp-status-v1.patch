@@ -178,6 +181,35 @@ struct btds4_process_t {
 
 static struct btds4_state states[MAX_CONTROLLERS] = {};
 
+void btds4_get_status(int number, uint32_t *flags, uint32_t *report_age_ms)
+{
+  *flags = 0;
+  *report_age_ms = UINT32_MAX;
+  if (number < 0 || number >= MAX_CONTROLLERS || !states[number].status_initialized)
+    return;
+  const struct btds4_state *s = states + number;
+  *flags = BTDS4_STATUS_INITIALIZED;
+  if (s->sys.shutdown)
+    *flags |= BTDS4_STATUS_SHUTDOWN;
+  else
+  {
+    if (s->ps4_channels.control.id >= 0)
+      *flags |= s->ps4_channels.control.pending ? BTDS4_STATUS_PS4_CONTROL_PENDING : BTDS4_STATUS_PS4_CONTROL;
+    if (s->ps4_channels.interrupt.id >= 0)
+      *flags |= s->ps4_channels.interrupt.pending ? BTDS4_STATUS_PS4_INTERRUPT_PENDING : BTDS4_STATUS_PS4_INTERRUPT;
+    if (s->ds4_channels.control.id >= 0) *flags |= BTDS4_STATUS_DS4_CONTROL;
+    if (s->ds4_channels.interrupt.id >= 0) *flags |= BTDS4_STATUS_DS4_INTERRUPT;
+  }
+  if (s->last_report_time)
+  {
+    *flags |= BTDS4_STATUS_REPORT_SENT;
+    gtime now = gtime_gettime();
+    gtime age = now >= s->last_report_time ? (now - s->last_report_time) / 1000000ULL : 0;
+    *report_age_ms = age >= UINT32_MAX ? UINT32_MAX - 1 : (uint32_t) age;
+  }
+}
