+/* Local UDP status extension v1. Flags are snapshots, not console acknowledgments. */
+#define BTDS4_STATUS_INITIALIZED         (1U << 0)
+#define BTDS4_STATUS_PS4_CONTROL         (1U << 1)
+#define BTDS4_STATUS_PS4_INTERRUPT       (1U << 2)
+#define BTDS4_STATUS_DS4_CONTROL         (1U << 3)
+#define BTDS4_STATUS_DS4_INTERRUPT       (1U << 4)
+#define BTDS4_STATUS_PS4_CONTROL_PENDING (1U << 5)
+#define BTDS4_STATUS_PS4_INTERRUPT_PENDING (1U << 6)
+#define BTDS4_STATUS_SHUTDOWN            (1U << 7)
+#define BTDS4_STATUS_REPORT_SENT         (1U << 8)
+void btds4_get_status(int number, uint32_t *flags, uint32_t *report_age_ms);
+
 int btds4_init(int btds4_number, int dongle_index, const char * bdaddr_dst);
 int btds4_listen(int btds4_number);
 void btds4_close(int btds4_number);
