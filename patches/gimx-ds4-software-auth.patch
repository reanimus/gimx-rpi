+/* User-supplied DS4 software authentication. GPL-3.0-or-later. */
+#ifndef DS4_SOFTWARE_AUTH_H
+#define DS4_SOFTWARE_AUTH_H
+#include <stddef.h>
+#include <stdint.h>
+struct ds4_software_auth;
+struct ds4_software_auth *ds4_software_open(const char *directory);
+void ds4_software_close(struct ds4_software_auth *auth);
+void ds4_software_reset(struct ds4_software_auth *auth);
+/* HID-style buffers include the report ID; the transport validates/rebuilds CRCs. */
+int ds4_software_set(struct ds4_software_auth *auth, const uint8_t *data, size_t length);
+int ds4_software_get(struct ds4_software_auth *auth, uint8_t *data, size_t length);
+#endif
